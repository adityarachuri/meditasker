    "@tanstack/react-virtual": "^3.13.12",
    "date-fns": "^4.1.0",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lodash": "^4.18.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.60.0",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.10",
    "recharts": "^3.0.2",
    "yup": "^1.6.1",
    "zustand": "^5.0.6"
